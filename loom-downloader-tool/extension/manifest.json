{
  "manifest_version": 3,
  "name": "Sifão — Baixador de aulas",
  "version": "3.0",
  "description": "Baixa aulas do Skool/Loom, vídeos do YouTube (por canal) e Vimeo — na página ou pelo curso inteiro, via um servidor local.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.loom.com/*",
    "*://*.skool.com/*",
    "*://*.youtube.com/*",
    "*://*.youtu.be/*",
    "http://localhost/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sifão — baixar vídeo / curso",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.skool.com/*",
        "*://*.loom.com/*"
      ],
      "js": ["content.js"],
      "css": ["ui.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": ["youtube.js"],
      "css": ["ui.css"],
      "run_at": "document_idle"
    }
  ]
}
